{% macro setSold(entry) %}
  <form class="m-0 p-0 d-inline-block" method="post" accept-charset="UTF-8" enctype="multipart/form-data">
    {{ csrfInput() }}
    {{ actionInput('entries/save-entry') }}
    {{ hiddenInput('sectionId', '1') }}
    {{ hiddenInput('enabled', '1') }}
    {{ hiddenInput('entryId', entry.id) }}
    {{ hiddenInput('fields[verkaufsstatus]', 'Verkauft') }}
    <button type="submit" class="btn btn-success rounded-pill">Artikel verkauft</button>
  </form>
{% endmacro %}

