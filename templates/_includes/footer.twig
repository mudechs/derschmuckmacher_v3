<div class="container-fluid">
  <div class="row">
    <div class="col-10 offset-1 py-3 py-lg-5">
      <div class="row">
        <div class="col-md-4 mb-3 mb-lg-0 d-lg-flex align-items-end">
          <a href="{{ siteUrl }}" title="Home" class="logo-footer d-block mt-2">
            <img src="{{ alias('@assetBaseUrl/images/logos/logo_hoch_dark.svg') }}" alt="Logo">
          </a>
        </div>
        <div class="col-md-4 mb-3 mb-lg-0 d-lg-flex align-items-end justify-content-center">
          {% set emailTitle = 'E-Mail senden'|t %}
          {% set plainEmail = 'info@derschmuckmacher.ch' %}
          {%- set email = '<a href="mailto:' ~ plainEmail ~ '" target="_top" class="content-link">' ~ emailTitle ~ '</a>' -%}

          <address class="mb-0">
            Der Schmuckmacher | Andreas Werner<br>
            Talstrasse 10<br>
            4900 Langenthal<br>
            <a href="tel:+41786672072">078 667 20 72</a> <span class="px-2">&middot;</span> {{ email|enkode_mailtos }}
          </address>
        </div>
        <div class="col-md-4 d-lg-flex align-items-end justify-content-end">
          <ul class="nav flex-column">
            <li class="nav-item">
              <a class="nav-link px-0 py-1" href="{{ alias('@web/impressum') }}" title="Impressum">Impressum</a>
            </li>
            <li class="nav-item">
              <a class="nav-link px-0 py-1" href="{{ alias('@web/datenschutz') }}" title="Datenschutz">Datenschutz</a>
            </li>
            <li>&nbsp;</li>
            <li class="nav-item">
              © {{ now|date('Y') }}, {{ siteName }}
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>