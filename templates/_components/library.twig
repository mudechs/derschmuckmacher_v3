{# Set default values #}
{% set schmuckTypOptions = craft.categories().group('schmuckTyp').orderBy('title ASC').all() %}
{% set firstCategory = schmuckTypOptions|first %}
{% set schmuckTyp = schmuckTyp ?? (firstCategory ? firstCategory.id : '') %}
{% set currentPage = currentPage ?? 1 %}
{% set perPage = 12 %}

{% set schmuckQuery = craft.entries()
  .section('schmuck')
  .verkaufsstatus('Verfügbar')
  .reservation(':empty:')
  .orderBy('postDate DESC')
  .status('live') %}

{% if schmuckTyp %}
  {% do schmuckQuery.typ(schmuckTyp) %}
{% endif %}

{% set totalEntries = schmuckQuery.count() %}
{% set totalPages = max(1, totalEntries // perPage + (totalEntries % perPage > 0 ? 1 : 0)) %}
{% set currentPage = min(currentPage, totalPages) %}

{% set entries = schmuckQuery.limit(perPage).offset((currentPage - 1) * perPage).all() %}

{% set thumb = {
  mode: 'crop',
  width: 612,
  height: 612,
  quality: 100,
  position: 'center-center'
} %}

{# Mobile: Dropdown (<768px) #}
<div class="d-md-none mt-3">
  <select sprig id="schmuckTyp" name="schmuckTyp" s-val:current-page="1" class="form-select border-white bg-light rounded-pill">
    {% for option in schmuckTypOptions %}
      <option value="{{ option.id }}" {{ schmuckTyp == option.id ? 'selected' }}>{{ option.title }}</option>
    {% endfor %}
  </select>
</div>

{% css %}
  .library-tabs .nav-link:hover { color: #2e2a27 !important; }
{% endcss %}

{# Desktop: Tab Nav (≥768px) #}
<ul class="library-tabs nav nav-tabs d-none d-md-flex justify-content-center mt-3 mb-5 border-0" role="tablist">
  {% for option in schmuckTypOptions %}
    <li class="nav-item" role="presentation">
      <a sprig
         class="nav-link border-0 bg-transparent {{ schmuckTyp == option.id ? 'active text-black' : 'text-primary' }}"
         style="cursor:pointer"
         s-val:schmuck-typ="{{ option.id }}"
         s-val:current-page="1"
         name="schmuckTyp"
         role="tab"
         aria-selected="{{ schmuckTyp == option.id ? 'true' : 'false' }}"
      >{{ option.title }}</a>
    </li>
  {% endfor %}
</ul>

<div class="row mt-4 mt-md-3">
  <div class="col">
    {% set ref = indicator %}
    {% include '_components/indicator.twig' %}

    <div class="row g-3 entries-grid">
      {% if entries %}
        {% for entry in entries %}
          {% set image = entry.schmuckbild.one() %}
          <div class="col-12 col-lg-4 mb-4">
            <a href="{{ entry.url }}" title="{{ entry.title }}" class="position-relative d-block">
              {% if image|length %}
                <img src="{{ image.url(thumb) }}" width="{{ image.getWidth(thumb) }}" height="{{ image.getHeight(thumb) }}" alt="{{ entry.title }}" class="img-fluid img-thumbnail">
              {% else %}
                <img src="{{ alias('@assetBaseUrl/images/placeholder.png') }}" alt="{{ entry.title }}" class="img-fluid img-thumbnail">
              {% endif %}
              <span class="position-absolute bottom-0 start-0 small text-white ps-3 pb-2">Ref.-Nr. {{ entry.id }}</span>
            </a>
          </div>
        {% endfor %}
      {% else %}
        <p>Keine Schmuckstücke mit diesen Auswahlkriterien vorhanden.</p>
      {% endif %}
    </div>

    {# Pagination #}
    {% if totalPages > 1 %}
      <nav class="mt-5" aria-label="Seitennavigation">
        <ul class="pagination justify-content-center">

          {# Zurück #}
          <li class="page-item {{ currentPage == 1 ? 'disabled' }}">
            <a sprig class="page-link" style="cursor:pointer"
               s-val:current-page="{{ currentPage - 1 }}"
               s-val:schmuck-typ="{{ schmuckTyp }}"
               aria-label="Zurück">
              <span aria-hidden="true">&lsaquo;</span>
            </a>
          </li>

          {% for page in 1..totalPages %}
            {% if
              page == 1 or
              page == totalPages or
              (page >= currentPage - 2 and page <= currentPage + 2)
            %}
              <li class="page-item {{ page == currentPage ? 'active' }}">
                <a sprig class="page-link" style="cursor:pointer"
                   s-val:current-page="{{ page }}"
                   s-val:schmuck-typ="{{ schmuckTyp }}">
                  {{ page }}
                </a>
              </li>
            {% elseif page == currentPage - 3 or page == currentPage + 3 %}
              <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
            {% endif %}
          {% endfor %}

          {# Vor #}
          <li class="page-item {{ currentPage == totalPages ? 'disabled' }}">
            <a sprig class="page-link" style="cursor:pointer"
               s-val:current-page="{{ currentPage + 1 }}"
               s-val:schmuck-typ="{{ schmuckTyp }}"
               aria-label="Vor">
              <span aria-hidden="true">&rsaquo;</span>
            </a>
          </li>

        </ul>
      </nav>
    {% endif %}

  </div>
</div>
