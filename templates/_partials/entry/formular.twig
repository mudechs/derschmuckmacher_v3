<div class="container-fluid">
  <div class="container pb-3 pb-lg-5">
    <div class="row">
      <div class="col-md-8">
        {% set form = entry.formular %}

        {{ craft.freeform.form(form.handle, {
          submitClass: "btn btn-lg btn-primary rounded-pill text-white mt-5"
        }).render() }}
      </div>
  </div>
</div>

{% js %}
  form.addEventListener("freeform-ready", function (event) {
  event.target.freeform.setOption("errorBannerMessage", "{{ 'Sorry, there was an error submitting the form. Please try again'|t('freeform') }}" );
  });
{% endjs %}