<div class="container-fluid">
  <div class="row pt-3 pt-lg-5">
    <div class="col-12 col-lg-10 offset-lg-1">
      <div class="row g-lg-5">
        {% set kacheln = entry.kacheln.all() %}
        {% if kacheln|length %}
          {% for kachel in kacheln %}
            <div class="col-12 col-lg-4">
              <div class="d-flex flex-column h-100">
                {% set image = kachel.bild.one() %}
                <div class="kachelimage">
                  <div class="overlay" style="background: url('{{ image.getUrl() }}') no-repeat center; background-size: cover;"></div>
                </div>
                <div class="p-5 d-flex flex-column flex-grow-1">
                  <h2 class="display-6">{{ kachel.title }}</h2>
                  <p class="mb-5">{{ kachel.lead }}</p>
                  {% if kachel.buttonLink %}
                    <div class="col-12 col-lg-8 col-wide-6 mt-auto">
                      <a href="{{ kachel.buttonLink.url }}" target="{{ kachel.buttonLink.target }}" class="btn btn-lg btn-primary py-3 px-4 viewport-toggle d-block">{{ kachel.buttonLink.title }}</a>
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</div>