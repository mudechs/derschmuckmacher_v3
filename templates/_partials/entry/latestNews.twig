{% set newsEntries = craft.entries()
  .section('aktuelles')
  .status('live')
  .aufStartseiteZeigen(true)
  .orderBy('postDate asc')
  .limit(2)
  .all() %}

{% if newsEntries | length %}
  <div class="py-3 py-lg-5"></div>

  <div class="container-fluid px-0">
    <div class="row g-0">
      {% for entry in newsEntries %}
        {% set bgImage = entry.bild.one() %}
        {% set textColor = entry.textfarbe %}
        {% set link = entry.externerLink %}

        <div class="{{ newsEntries | length == 2 ? 'col-md-6' : 'col-12' }}">
          <a href="{{ link ? link }}" target="_blank" rel="noopener, nofollow" class="text-decoration-none d-block h-100">
            <div class="bg-blur h-100" style="background-image: url('{{ bgImage ? bgImage.getUrl() }}'); cursor: pointer;">
              <div class="row h-100">
                <div class="col-10 offset-1" style="padding: 200px 0;">
                  <h2 class="display-2 mb-0" {% if textColor %}style="color: {{ textColor }};"{% endif %}>
                    {{ entry.title }}
                  </h2>
                  <p class="display-3 mb-0" {% if textColor %}style="color: {{ textColor }};"{% endif %}>
                    {{ entry.zeile1 }}<br>
                    {{ entry.zeile2 }}<br>
                    {{ entry.zeile3 }}
                  </p>
                </div>
              </div>
            </div>
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}