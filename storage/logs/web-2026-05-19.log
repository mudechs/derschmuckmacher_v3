] {"environment":"dev","userId":1,"body":"{\"pluginLicenses\":[{\"id\":266191,\"pluginId\":974,\"editionId\":1585,\"ownerId\":23407,\"cloudProjectId\":null,\"cmsLicenseId\":832671,\"pluginHandle\":\"freeform\",\"edition\":\"pro\",\"trial\":false,\"expirable\":true,\"expired\":false,\"autoRenew\":true,\"reminded\":false,\"renewalPrice\":\"79.0000\",\"email\":\"info@codiac.ch\",\"key\":\"••••••••••••••••••••••••\",\"notes\":\"derschmuckmacher.ch\",\"lastVersion\":\"5.15.13\",\"lastAllowedVersion\":\"5.15.13\",\"lastActivityOn\":\"2026-05-19T10:26:10+00:00\",\"lastStatus\":\"valid\",\"lastRenewedOn\":\"2026-04-10T00:01:56+00:00\",\"expiresOn\":\"2027-04-10T00:01:56+00:00\",\"dateCreated\":\"2022-10-13T00:58:47+00:00\",\"dateUpdated\":\"2026-05-19T10:26:10+00:00\",\"uid\":\"28e0ca85-d820-40a0-892e-c6a47f2d9e33\",\"cmsLicenseKey\":null,\"cmsLicenseDomain\":null,\"plugin\":{\"enabled\":true,\"published\":true,\"developerId\":989980,\"packageId\":1608,\"iconId\":973,\"packageName\":\"solspace\\/craft-freeform\",\"repository\":\"https:\\/\\/github.com\\/solspace\\/craft-freeform\",\"name\":\"Freeform\",\"handle\":\"freeform\",\"license\":\"craft\",\"minCmsEdition\":\"solo\",\"shortDescription\":\"The most flexible and user-friendly form building plugin!\",\"longDescription\":\"# The most flexible and user-friendly form builder!\\r\\n\\r\\nFreeform is the most flexible form builder for Craft CMS, built to work the way Craft developers do. From simple contact forms to complex multi page workflows with conditional logic, it adapts to your needs, with 50+ integrations, full headless support, and seamless templating.\\r\\n\\r\\nThe same 5.x version works on Craft 5.x, Craft 4.x and Craft Cloud.\\r\\n\\r\\n---\\r\\n\\r\\n## Express (FREE)\\r\\nGreat for simple sites. Switch to Lite or Pro anytime.\\r\\n\\r\\n- ✓ 1 form\\r\\n- ✓ Up to 20 fields\\r\\n- ✓ Basic field types\\r\\n- ✓ Drag & drop form builder\\r\\n- ✓ Email Notifications\\r\\n- ✓ Store, view and edit submissions\\r\\n- ✓ Export submission data\\r\\n- ✓ GDPR compliant\\r\\n- ✓ Spam protection\\r\\n- ✓ Spam folder\\r\\n- ✓ 15 starter themes\\r\\n- ✓ Migrate from Formie\\r\\n- ✓ Translations for  🇺🇸 🇬🇧 English, 🇫🇷 French, 🇩🇪 German, 🇳🇱 Dutch and 🇮🇹 Italian.\\r\\n\\r\\n## Lite ($99)\\r\\nAll of the essentials. Switch to Pro anytime.\\r\\n\\r\\n_Everything in Express plus..._\\r\\n- ✓ Unlimited forms\\r\\n- ✓ Unlimited fields\\r\\n- ✓ Multi-page forms\\r\\n- ✓ Export profiles\\r\\n- ✓ Attach forms to entries\\r\\n- ✓ Attach submissions to entries\\r\\n- ✓ GraphQL support\\r\\n- ✓ Email failure alerts\\r\\n- ✓ Weekly\\/daily digest\\r\\n\\r\\n## Pro ($149)\\r\\nOur most popular edition for complex setups.\\r\\n\\r\\n_Everything in Lite plus..._\\r\\n- ✓ Advanced field types\\r\\n- ✓ AI field type, AI spam analysis\\r\\n- ✓ Conditional rules\\r\\n- ✓ Save & continue later\\r\\n- ✓ Field encryption\\r\\n- ✓ A\\/B Testing\\r\\n- ✓ Dynamic PDF templates\\r\\n- ✓ Edit submissions on front end\\r\\n- ✓ Automatically purge submission data\\r\\n- ✓ Export email notifications\\r\\n- ✓ Dashboard widgets\\r\\n- ✓ Site-aware forms\\r\\n- ✓ Translations per site inside builder\\r\\n- ✓ Surveys & Polls reporting\\r\\n- ✓ Craft element integrations\\r\\n- ✓ Over 50 integrations\\r\\n- ✓ Accept payments (Stripe, PayPal & more)\\r\\n- ✓ Quickly build new forms with AI\\r\\n- ✓ 1000 SolspaceAI credits\\r\\n- ✓ Form Monitoring service\\r\\n- ✓ Queue Pinging service\\r\\n\\r\\n---\\r\\n\\r\\n## Why Freeform?\\r\\nThousands of sites trust Freeform and our team to deliver the quality and support they need.\\r\\n\\r\\n### Top Notch Support\\r\\nWe’re trusted in the Craft CMS community for reliable, high-quality support.\\r\\n\\r\\n### 25+ Years Experience\\r\\nFor more than 25 years, Solspace has been busy creating and supporting software for over tens of thousands of sites.\\r\\n\\r\\n### Active Development\\r\\nFreeform is continuously updated with a ton of new features, improvements, and bug fixes over time.\",\"documentationUrl\":\"https:\\/\\/docs.solspace.com\\/craft\\/freeform\\/v5\\/\",\"changelogPath\":\"CHANGELOG.md\",\"latestVersionId\":null,\"latestVersion\":\"5.15.13\",\"latestVersionTime\":null,\"compatibleCmsVersion\":null,\"pendingApproval\":false,\"keywords\":\"freeform, freeform, freeform, forms, formie, formie, formie, widgets, surveys, polls, contact, emails, notifications, table, salesforce, pardot, mailchimp, slack, zapier, webhooks, stripe, sprout forms, wheel forms, am forms, graphql, google, rules, recaptcha, hcaptcha, captcha, zoho, conditional logic, express forms, freshdesk, infusionsoft, clickdimensions, hubspot, microsoft dynamics, payments, commerce, ecommerce, ai, openai, gemini, grok, claude, solspaceai, jira, sheets, spreadsheet, cloudflare, turnstile, turnstyle, friendly captcha, form monitor, translations, gtm, utm, pdf\",\"dateApproved\":\"2018-01-24T17:57:11+00:00\",\"totalPurchases\":null,\"ratingAvg\":null,\"ratingAvgBayesian\":null,\"totalReviews\":null,\"abandoned\":false,\"note\":null,\"replacementId\":null,\"cloudTested\":true,\"supportsGql\":true,\"eagerLoadInfo\":null,\"id\":974,\"tempId\":null,\"draftId\":null,\"revisionId\":null,\"isProvisionalDraft\":false,\"hasProvisionalChanges\":false,\"uid\":\"e3e0299b-f117-43c5-a25c-db9a1a445710\",\"siteSettingsId\":2676,\"fieldLayoutId\":null,\"archived\":false,\"siteId\":1,\"title\":null,\"slug\":null,\"uri\":null,\"dateCreated\":\"2018-01-24T17:57:11+00:00\",\"dateUpdated\":\"2026-05-12T15:58:45+00:00\",\"dateLastMerged\":null,\"dateDeleted\":null,\"deletedWithOwner\":null,\"trashed\":false,\"forceSave\":false,\"canonicalId\":974,\"cpEditUrl\":\"https:\\/\\/api.craftcms.com\\/paloma\\/plugins\\/974-freeform\",\"isDraft\":false,\"isRevision\":false,\"isUnpublishedDraft\":false,\"ref\":null,\"status\":\"enabled\",\"structureId\":null,\"url\":\"https:\\/\\/plugins.craftcms.com\\/freeform\",\"developerName\":\"Solspace\",\"icon\":{\"isFolder\":false,\"sourcePath\":null,\"folderId\":4