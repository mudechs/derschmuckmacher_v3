                    'fields' => [
                        'body' => '<h2>
    Der Schmuckmacher
</h2>
<p>
    Andreas Werner<br>
    Talstrasse 10<br>
    4900 Langenthal<br>
    Schweiz
</p>
<p>
    <a href=\"https://derschmuckmacher-v3.ddev.site/kontakt#entry:6476@1:url\" target=\"_blank\">Kontakt via E-Mail</a>
</p>
<h2>
    Gestaltung &amp; Fotografie
</h2>
<p>
    Andrea Geiser, Aarwangen<br>
    <figure class=\"image\">
    <a href=\"https://www.raumundinhalt.ch/\" target=\"_blank\" rel=\"noopener\"><img style=\"aspect-ratio:300/31;\" src=\"https://derschmuckmacher-v3.ddev.site/public/uploads/bilder/raumundinhalt_logo.svg#asset:9073:url\" alt=\"Raum &amp; Inhalt Logo\" width=\"300\" height=\"31\"></a>
</figure>
</p>

