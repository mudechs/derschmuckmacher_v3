                        'body' => '<h3>
    Der Schmuckmacher
</h3>
<p>
    Andreas Werner<br>
    Talstrasse 10<br>
    4900 Langenthal<br>
    Schweiz
</p>
<p>
    <a href=\"https://derschmuckmacher-v3.ddev.site/kontakt#entry:6476@1:url\" target=\"_blank\">Kontakt via E-Mail</a>
</p>
<p>
    &nbsp;
</p>
<h3>
    Gestaltung &amp; Fotografie
</h3>
<p>
    Andrea Geiser, Aarwangen
</p>
<figure class=\"image\">
    <a href=\"https://www.raumundinhalt.ch/\"><img style=\"aspect-ratio:300/31;\" src=\"https://derschmuckmacher-v3.ddev.site/public/uploads/bilder/raumundinhalt_logo.svg#asset:9073:url\" alt=\"Raum &amp; Inhalt Logo\" width=\"300\" height=\"31\"></a>
</figure>
<p>
    Grafik-Design für visuelle Firmenauftritte, Konzepte &amp; Beratung
</p>
<p>
    &nbsp;
</p>
